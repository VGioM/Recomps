{
  "name": "recomps",
  "productName": "Recomps",
  "version": "1.3.2",
  "description": "Parcourir, télécharger et tenir à jour les recomps PC de recomplauncher.com",
  "author": "VGioM",
  "license": "UNLICENSED",
  "homepage": "https://github.com/VGioM/Recomps",
  "main": "src/main.js",
  "desktopName": "recomps.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "me.vgiom.recomps",
    "productName": "Recomps",
    "artifactName": "Recomps-${version}-linux-x86_64.${ext}",
    "files": [
      "src/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Game",
      "synopsis": "Recomps PC de recomplauncher.com",
      "syncDesktopName": true
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "44.11.1",
    "electron-builder": "26.18.0"
  }
}
